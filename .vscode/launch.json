{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Run Python Microservice (FastAPI :8001)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8001",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/data-analysis-statistics",
            "python": "${workspaceFolder}/data-analysis-statistics/.venv313/Scripts/python.exe"
        }
    ]
}
